# Pinned versions — every number here matches the machine this repo was
# exported from. Bump a line and re-run the matching step to upgrade.

# Editor
NVIM_VERSION=0.12.4

# Languages
# NOTE: Go 1.22.5 is what the source machine ran. Go's toolchain auto-download
# still builds modules that require newer versions, but bump this if you want a
# supported release (see https://go.dev/dl/).
GO_VERSION=1.22.5
NODE_TARGET=--lts         # nvm argument: --lts tracks the current Node LTS
NVM_VERSION=v0.40.6
ZIG_VERSION=0.14.1

# CLI tools
RIPGREP_VERSION=15.2.0
FD_VERSION=10.4.2
BAT_VERSION=0.26.1
DELTA_VERSION=0.19.2
EZA_VERSION=v0.23.5
ZOXIDE_VERSION=0.10.0
STARSHIP_VERSION=v1.26.0
FZF_VERSION=v0.74.0
TREE_SITTER_VERSION=v0.26.11
UV_VERSION=0.11.29

# Fonts
NERD_FONTS_VERSION=v3.4.0

# Go tools (installed with `go install <pkg>@<version>`)
GOPLS_VERSION=v0.23.0
GOFUMPT_VERSION=v0.10.0
DELVE_VERSION=v1.27.0
GOLANGCI_LINT_VERSION=v2.12.2
GOMODIFYTAGS_VERSION=v1.17.0
IMPL_VERSION=v1.5.0
IFERR_VERSION=v1.0.0

# Python tools (installed with `uv tool install`, always at their latest
# release — pin one as "ruff==0.15.22" here if you need a fixed version)
UV_PYTHON_VERSION=3.12
PY_TOOLS="ruff black ipython poetry pipx virtualenv"
